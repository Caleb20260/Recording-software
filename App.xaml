<Application x:Class="LubbInteractiveCreator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#101419" />
    <SolidColorBrush x:Key="PanelBrush" Color="#171D24" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#202832" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2B3742" />
    <SolidColorBrush x:Key="TextBrush" Color="#F0F4F6" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#91A0AA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#54D6C7" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B85B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F27D7D" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
  </Application.Resources>
</Application>