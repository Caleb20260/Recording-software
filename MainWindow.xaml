<Window x:Class="LubbInteractiveCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lubb Interactive Creator"
        Width="1440" Height="900" MinWidth="760" MinHeight="620"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0D1115" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="24,28">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="LUBB" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="INTERACTIVE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="2,-2,0,34" />
          <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
          <Button Content="HOME" HorizontalContentAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="#0D1115" BorderThickness="0" />
          <Button Content="CREATOR" HorizontalContentAlignment="Left" />
          <Button Content="SCENES" HorizontalContentAlignment="Left" />
          <Button Content="AUDIO" HorizontalContentAlignment="Left" />
          <Button Content="RECORDING" HorizontalContentAlignment="Left" />
          <Button Content="STREAMING" HorizontalContentAlignment="Left" />
          <Button Content="CLIPS &amp; EDITOR" HorizontalContentAlignment="Left" />
          <Button Content="MEDIA" HorizontalContentAlignment="Left" />
          <TextBlock Text="SERVICES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,26,0,12" />
          <Button Content="XBOX HUB" HorizontalContentAlignment="Left" Command="{Binding ConnectXboxCommand}" />
          <Button Content="DISCORD HUB" HorizontalContentAlignment="Left" Command="{Binding ConnectDiscordCommand}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="SECURITY &amp; PRIVACY" HorizontalContentAlignment="Left" Command="{Binding PrivacyCommand}" />
          <Button Content="SETTINGS" HorizontalContentAlignment="Left" />
          <TextBlock Text="EST. 2026" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="2,14,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="42,30,42,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,34">
        <StackPanel>
          <TextBlock Text="CREATOR HOME" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="Good to see you." FontSize="31" FontWeight="SemiBold" Margin="0,4,0,0" />
          <TextBlock Text="Build your next session from one calm workspace." FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="NEW PROJECT" Command="{Binding NewProjectCommand}" Background="{StaticResource AccentBrush}" Foreground="#0D1115" BorderThickness="0" />
          <Button Content="SAVE PROJECT" Command="{Binding SaveProjectCommand}" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="#142B2C" BorderBrush="#275958" BorderThickness="1" Padding="20" Margin="0,0,0,26">
        <Grid>
          <StackPanel>
            <TextBlock Text="CURRENT PROJECT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="{Binding ProjectName}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
            <TextBlock Text="Gaming scene  |  Default Profile" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
          </StackPanel>
          <TextBlock Text="READY TO BUILD" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="SESSION STATUS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
          <UniformGrid Columns="5" Margin="0,0,0,30">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="RECORDING" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding RecordingStatus}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" /></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="STREAMING" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding StreamingStatus}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" /></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="REPLAY" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding ReplayStatus}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0" /></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,10,0">
              <StackPanel><TextBlock Text="XBOX" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding XboxStatus}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" /></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
              <StackPanel><TextBlock Text="DISCORD" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding DiscordStatus}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" /></StackPanel>
            </Border>
          </UniformGrid>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,22,0">
              <TextBlock Text="QUICK ACTIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
              <WrapPanel>
                <Button Content="START RECORDING" Command="{Binding StartRecordingCommand}" Background="{StaticResource AccentBrush}" Foreground="#0D1115" BorderThickness="0" />
                <Button Content="PAUSE / RESUME" Command="{Binding PauseRecordingCommand}" />
                <Button Content="STOP" Command="{Binding StopRecordingCommand}" />
                <Button Content="GO LIVE" Command="{Binding GoLiveCommand}" />
                <Button Content="SAVE REPLAY" Command="{Binding SaveReplayCommand}" />
                <Button Content="CREATE CLIP" Command="{Binding CreateClipCommand}" />
              </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="SYSTEM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" />
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"><TextBlock Text="CPU" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="--" FontSize="20" Margin="0,5,0,0" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="GPU" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="--" FontSize="20" Margin="0,5,0,0" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="STORAGE" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="--" FontSize="20" Margin="0,5,0,0" /></StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>

          <TextBlock Text="RECORDING ENGINE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,30,0,12" />
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
            <Grid>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="FFMPEG PATH" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RecordingSettings.FfmpegPath, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="8,3,18,3" Background="{StaticResource PanelRaisedBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="OUTPUT FOLDER" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
              <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding RecordingSettings.OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="8,3,0,3" Background="{StaticResource PanelRaisedBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="WIDTH" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RecordingSettings.Width, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="8,3,18,3" Background="{StaticResource PanelRaisedBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="HEIGHT" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
              <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding RecordingSettings.Height, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="8,3,0,3" Background="{StaticResource PanelRaisedBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="FPS" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RecordingSettings.FramesPerSecond, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="8,3,18,3" Background="{StaticResource PanelRaisedBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="BITRATE KBPS" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
              <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding RecordingSettings.VideoBitrateKbps, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="8,3,0,3" Background="{StaticResource PanelRaisedBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="MIC DEVICE" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11" />
              <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding RecordingSettings.MicrophoneDevice, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="8,3,0,3" Background="{StaticResource PanelRaisedBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" />
            </Grid>
          </Border>

          <TextBlock Text="SCENE BUILDER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,30,0,12" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,14,0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                  <Button Content="NEW SCENE" Command="{Binding NewSceneCommand}" Background="{StaticResource AccentBrush}" Foreground="#0D1115" BorderThickness="0" />
                  <Button Content="DUPLICATE" Command="{Binding DuplicateSceneCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" Padding="8" FontSize="13" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
              <StackPanel>
                <TextBlock Text="SELECTED SCENE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                <Grid Margin="0,8,0,14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding SceneNameDraft, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="8" Background="{StaticResource PanelRaisedBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" />
                  <Button Grid.Column="1" Content="RENAME" Command="{Binding RenameSceneCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="SOURCES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                <ListBox ItemsSource="{Binding SelectedScene.Sources}" Background="Transparent" BorderThickness="0" Margin="0,5,0,10" MinHeight="72">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel>
                  <Button Content="GAME CAPTURE" Command="{Binding AddSourceCommand}" CommandParameter="Game Capture" />
                  <Button Content="DISPLAY" Command="{Binding AddSourceCommand}" CommandParameter="Display Capture" />
                  <Button Content="WEBCAM" Command="{Binding AddSourceCommand}" CommandParameter="Camera" />
                  <Button Content="MICROPHONE" Command="{Binding AddSourceCommand}" CommandParameter="Microphone" />
                  <Button Content="IMAGE" Command="{Binding AddSourceCommand}" CommandParameter="Image" />
                  <Button Content="BROWSER" Command="{Binding AddSourceCommand}" CommandParameter="Browser" />
                </WrapPanel>
                <TextBlock Text="{Binding SourceCount, StringFormat={}{0} sources in this scene}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <TextBlock Text="SECURITY CENTER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,30,0,12" />
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"><TextBlock Text="APPLICATION" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding Security.ApplicationIntegrity}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="PLUGINS" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding Security.PluginSecurity}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="CREDENTIALS" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding Security.CredentialStorage}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" /></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="UPDATES" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding Security.UpdateSecurity}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" /></StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="PRIVACY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,24,0,12" />
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
            <StackPanel Orientation="Horizontal">
              <CheckBox Content="Optional analytics" IsChecked="{Binding AnalyticsEnabled}" Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,28,0" VerticalContentAlignment="Center" />
              <CheckBox Content="Crash reports" IsChecked="{Binding CrashReportsEnabled}" Foreground="{StaticResource TextBrush}" FontSize="13" VerticalContentAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="{Binding Notice}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,5,0,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>